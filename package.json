{
  "name": "nextlearn",
  "version": "1.0.0",
  "description": "NextLearn interface served by a Node.js + TypeScript backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "seed:login-users": "tsx scripts/seed-login-users.ts",
    "seed:modules": "tsx scripts/seed-modules.ts",
    "migrate:subject-modules": "tsx scripts/migrate-to-subject-modules.ts",
    "seed:clustering-demo": "tsx scripts/seed-clustering-demo.ts",
    "seed:demo-classes": "tsx scripts/seed-demo-classes.ts",
    "resync:quizzes": "tsx scripts/resync-quizzes.ts",
    "reindex:rag": "tsx scripts/reindex-rag.ts",
    "generate:training-data": "tsx scripts/generate-training-data.ts",
    "train:model": "python ml/train.py",
    "shap:install": "python -m pip install -r ml/requirements.txt",
    "shap:serve": "python ml/shap_service.py"
  },
  "keywords": [
    "node",
    "typescript",
    "express",
    "learning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mongoose": "^9.3.3",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
