# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── Required ───────────────────────────────────────────────────────────────
# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# Secret used to sign session JWTs. The server REFUSES TO START in production
# without it (development falls back to a fixed insecure default, with a warning).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# PUBLIC url of the app — used in password reset links, so it must be a URL
# students can actually open in a browser (your real domain in production).
APP_BASE_URL=http://localhost:3000

# How the Python ML service reaches the app to fetch course files when it
# rebuilds the chatbot index. Only set this when the two run on different hosts:
# in Docker Compose it must be the service name (http://app:3000), because the
# public APP_BASE_URL above is not resolvable from inside the ML container.
# Defaults to APP_BASE_URL when unset, which is correct for a single host.
# INTERNAL_BASE_URL=http://app:3000

# ── LLM / embeddings (chatbot + AI quiz generation) ────────────────────────
# Gemini is preferred when its key is present; otherwise the OPENAI_* vars are
# used (they are OpenAI-compatible, so OpenRouter works here too).
# With no key at all the chatbot still answers, but from deterministic extracts
# of the indexed course content rather than a generated reply, and AI quiz
# generation is unavailable.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENAI_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Python ML service ──────────────────────────────────────────────────────
# Where the Node app expects the ML service. Node auto-starts a local one when
# this is unset; point it at a running instance (e.g. http://ml:8000 in Compose)
# to adopt that instead of spawning a second copy.
# SHAP_SERVICE_URL=http://localhost:8000
# PYTHON_BIN=python

# ── SMTP (password reset emails) ───────────────────────────────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="NextLearn <no-reply@your-domain.com>"
